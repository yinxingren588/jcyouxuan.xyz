---
import {airports,price,traffic,type Airport} from '../data/airports';
interface Props {items?:Airport[]}
const {items=airports}=Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label="29 品牌参考方案表，可横向滚动"><table><caption>按站长指定顺序展示 · 第三方套餐参考，非实时报价或性能排名</caption><thead><tr><th scope="col">顺序 / 品牌</th><th scope="col">选定月付档</th><th scope="col">标称流量</th><th scope="col">选择侧重点</th><th scope="col">指定优惠码</th><th scope="col">资料与入口</th></tr></thead><tbody>{items.map(a=><tr data-brand={a.slug}><th scope="row"><span class="order-number">{String(a.order).padStart(2,'0')}</span>{a.name}</th><td>{price(a.plans[0])}{a.plans[0]&&<small class="muted" style="display:block">{a.plans[0].name}</small>}</td><td>{traffic(a.plans[0])}</td><td>{a.focus}</td><td>{a.coupon?<code>{a.coupon}</code>:'未提供'}</td><td><a href={`/airport/${a.slug}/`}>推荐理由</a><br/><a href={a.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">当前套餐（推广）↗</a></td></tr>)}</tbody></table></div>
