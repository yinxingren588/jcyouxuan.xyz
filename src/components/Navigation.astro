---
import {topics} from '../data/site';
import {scenarios} from '../data/selection';
const route=Astro.url.pathname;
const ranks=[['overall','站长推荐目录','按指定顺序读推荐依据'],['budget','月付预算比较','按价格和用量筛选'],['traffic','流量档位比较','按所需容量匹配套餐'],['value','套餐成本测算','区分标称容量与实际扣量'],['stable','晚高峰稳定性核查','记录模板与判断标准']];
---
<nav id="navigation" aria-label="主导航"><a href="/" aria-current={route==='/'?'page':undefined}>机场推荐</a><div class="nav-group"><div class="nav-group-head"><a href="/recommend/" aria-current={route.startsWith('/recommend/')?'page':undefined}>按需选购</a><button class="nav-expand" type="button" aria-label="展开按需选购菜单" aria-expanded="false" aria-controls="recommend-menu"><span aria-hidden="true">⌄</span></button></div><div class="nav-dropdown" id="recommend-menu" hidden><div class="nav-dropdown-inner"><a class="nav-overview" href="/recommend/">推荐中心 <span>全部场景 →</span></a>{topics.map(t=><a href={`/recommend/${t.slug}/`}><span class="nav-symbol" aria-hidden="true">{t.icon}</span><span><strong>{scenarios[t.slug].title}</strong><small>{t.description}</small></span></a>)}</div></div></div><div class="nav-group"><div class="nav-group-head"><a href="/ranking/" aria-current={route.startsWith('/ranking/')?'page':undefined}>机场排行</a><button class="nav-expand" type="button" aria-label="展开机场排行菜单" aria-expanded="false" aria-controls="ranking-menu"><span aria-hidden="true">⌄</span></button></div><div class="nav-dropdown" id="ranking-menu" hidden><div class="nav-dropdown-inner"><a class="nav-overview" href="/ranking/">排行与比较中心 <span>查看口径 →</span></a>{ranks.map(([key,title,description])=><a href={`/ranking/${key}/`}><span><strong>{title}</strong><small>{description}</small></span></a>)}</div></div></div><a class="nav-compare" href="/compare/" aria-current={route==='/compare/'?'page':undefined}>机场对比</a><a href="/review/" aria-current={route.startsWith('/review/')?'page':undefined}>品牌分析</a><a href="/guides/" aria-current={route.startsWith('/guides/')?'page':undefined}>使用教程</a><a href="/blog/" aria-current={route.startsWith('/blog/')?'page':undefined}>博客资讯</a></nav>
<script>
const groups=[...document.querySelectorAll<HTMLElement>('.nav-group')];
function closeGroups(except?:HTMLElement){groups.forEach(group=>{if(group!==except){group.querySelector<HTMLButtonElement>('button')!.setAttribute('aria-expanded','false');group.querySelector<HTMLElement>('.nav-dropdown')!.hidden=true}})}
groups.forEach(group=>{const button=group.querySelector<HTMLButtonElement>('button')!,panel=group.querySelector<HTMLElement>('.nav-dropdown')!;const open=()=>{closeGroups(group);button.setAttribute('aria-expanded','true');panel.hidden=false};button.addEventListener('click',()=>{if(panel.hidden)open();else closeGroups()});button.addEventListener('keydown',event=>{if(event.key==='ArrowDown'){event.preventDefault();open();panel.querySelector<HTMLAnchorElement>('a')?.focus()}});group.addEventListener('pointerenter',()=>{if(matchMedia('(hover:hover) and (min-width:761px)').matches)open()});group.addEventListener('pointerleave',()=>{if(matchMedia('(hover:hover) and (min-width:761px)').matches&&!group.contains(document.activeElement))closeGroups()});group.addEventListener('focusout',()=>queueMicrotask(()=>{if(!group.contains(document.activeElement))closeGroups()}));group.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();closeGroups();button.focus()}})});
document.addEventListener('click',event=>{if(!(event.target as Element).closest('.nav-group'))closeGroups()});
</script>
