---
import {airports,price,traffic,unitCost,missing} from '../data/airports';
const comparison=airports.map(a=>({slug:a.slug,name:a.name,values:[price(a.plans[0]),traffic(a.plans[0]),unitCost(a.plans[0])===null?'不可计算':`${a.plans[0].currency} ${unitCost(a.plans[0])!.toFixed(3)} / GB`,a.regions.join('、')||missing,a.protocols.join('、')||missing,a.deviceLimit||missing,a.aiSupport?.join('、')||missing,a.streamingSupport?.join('、')||missing,a.advantages.join('；'),a.disadvantages.join('；')]}));
---
<div id="comparison" data-brands={JSON.stringify(comparison)}><div class="compare-options">{airports.map(a=><label class="compare-choice"><input type="checkbox" value={a.slug} name="compare-brand"/> {a.name}</label>)}</div><p class="muted more-space" aria-live="polite" id="compare-status">选择 2–4 家品牌开始比较。</p><div id="compare-empty" class="empty">还没有足够的候选。先勾选两家，再逐项查看差异。</div><div id="compare-output" class="table-scroll" tabindex="0" role="region" aria-label="已选品牌比较，可横向滚动" hidden><table class="compare-table"><thead id="compare-head"></thead><tbody id="compare-body"></tbody></table></div><noscript><p>互动筛选需要 JavaScript。下方静态资料表和所有品牌详情仍可直接阅读。</p></noscript></div>
<script>
const root=document.querySelector<HTMLElement>('#comparison')!;const brands=JSON.parse(root.dataset.brands!) as {slug:string;name:string;values:string[]}[];const inputs=[...root.querySelectorAll<HTMLInputElement>('input')];const status=document.querySelector('#compare-status')!;const labels=['参考方案价格','方案流量','每 GB 成本','节点地区','协议','设备限制','AI 支持','流媒体支持','优点','注意事项'];
function update(){let selected=inputs.filter(i=>i.checked);inputs.forEach(i=>i.disabled=selected.length>=4&&!i.checked);const chosen=brands.filter(b=>selected.some(i=>i.value===b.slug));status.textContent=chosen.length<2?'请选择至少 2 家品牌。':`已选择 ${chosen.length} / 4 家。公开资料不等于实际表现。`;const active=chosen.length>=2;(document.querySelector('#compare-empty') as HTMLElement).hidden=active;(document.querySelector('#compare-output') as HTMLElement).hidden=!active;const head=document.querySelector('#compare-head')!;const body=document.querySelector('#compare-body')!;head.replaceChildren();body.replaceChildren();if(!active)return;const tr=document.createElement('tr');const first=document.createElement('th');first.scope='col';first.textContent='比较维度';tr.append(first);for(const b of chosen){const th=document.createElement('th');th.scope='col';const a=document.createElement('a');a.href=`/airport/${b.slug}/`;a.textContent=b.name;const remove=document.createElement('button');remove.className='compare-remove';remove.textContent='移除';remove.setAttribute('aria-label',`移除 ${b.name}`);remove.addEventListener('click',()=>{inputs.find(i=>i.value===b.slug)!.checked=false;update();inputs.find(i=>i.value===b.slug)!.focus()});th.append(a,remove);tr.append(th)}head.append(tr);labels.forEach((label,index)=>{const row=document.createElement('tr');const th=document.createElement('th');th.scope='row';th.textContent=label;row.append(th);for(const b of chosen){const td=document.createElement('td');td.textContent=b.values[index];row.append(td)}body.append(row)})}
inputs.forEach(i=>i.addEventListener('change',update));update();
</script>
