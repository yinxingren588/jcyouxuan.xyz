---
import {airports,price,traffic} from '../data/airports';
import {brandEditorial} from '../data/brand-editorial';
import {couponStatus} from '../data/coupon-status';
const comparison=airports.map(a=>({...a,positioning:brandEditorial[a.slug].positioning,audience:brandEditorial[a.slug].audience,couponLabel:couponStatus(a).label}));
---
<section id="comparison" class="comparison-workspace" data-brands={JSON.stringify(comparison)}><div class="section-intro"><div><span class="eyebrow">YOUR COMPARISON WORKSPACE</span><h2>选品牌，再选各自的具体档位</h2><p>最多比较 4 家。每列可以切换套餐，价格与容量同步更新，避免用一家的入门档对比另一家的高档却没有说明。</p></div><div class="hub-stat"><strong>2–4</strong><span>家品牌并排核对</span><small>支持保存为可复制的对比链接</small></div></div><div class="compare-presets"><span>快速开始：</span><button type="button" class="filter-chip" data-preset="twilight,lightyear">小额月付</button><button type="button" class="filter-chip" data-preset="flycat,u1s1" data-need="300">300GB 参考档</button><button type="button" class="filter-chip" data-preset="wavenet,breezenet" data-need="500">较高用量</button></div><div class="filter-toolbar"><label class="brand-search-label">搜索品牌<input type="search" name="brand-search" placeholder="中文名或英文名，例如浪网 / WaveNet" autocomplete="off"/></label><label>首档参考月费<select name="brand-budget"><option value="all">不限预算</option><option value="20">不超过 ¥20</option><option value="30">不超过 ¥30</option><option value="50">不超过 ¥50</option></select></label><label class="inline-checkbox"><input type="checkbox" name="coupon-only"/>仅看有指定优惠码的品牌</label></div><p class="brand-filter-status muted" aria-live="polite">显示全部 29 家；已选品牌始终保留在列表中。</p><div class="compare-toolbar"><div><strong id="compare-count">已选择 0 / 4 家</strong><div class="selected-tray" aria-label="已选品牌"></div></div><div class="compare-toolbar-actions"><label class="inline-checkbox"><input type="checkbox" id="compare-differences"/>只看不同项</label><button type="button" class="button" id="compare-jump" disabled>查看对比结果 ↓</button><button type="button" class="button secondary" id="compare-clear">清空选择</button><button type="button" class="button secondary" id="compare-share" disabled>复制对比链接</button></div></div><fieldset class="brand-picker"><legend class="sr-only">选择要比较的品牌，最多 4 家</legend><div class="compare-options">{airports.map(a=><label class="compare-choice" data-picker-brand={a.slug} data-search={(a.name+' '+a.slug).toLocaleLowerCase()}><input type="checkbox" value={a.slug} name="compare-brand"/><span class="choice-content"><strong>{a.name}</strong><small>{a.plans[0]?price(a.plans[0])+' · '+traffic(a.plans[0]):'当前报价未核实'}</small></span>{a.coupon&&<span class="choice-coupon">有指定码</span>}</label>)}</div></fieldset><p id="share-feedback" class="muted" aria-live="polite"></p><input class="share-url" aria-label="对比链接，复制失败时可手动选择" readonly hidden/><p class="filter-status" aria-live="polite" id="compare-status">选择 2–4 家品牌开始比较。</p><div id="compare-empty" class="empty"><h3>先选两家，具体差异就会出现在这里</h3><p>可从上面的快捷组合开始，再切换每列的套餐。没有核实的字段会保留说明，不会按零价格或零限制处理。</p></div><div id="compare-output" class="table-scroll" tabindex="0" role="region" aria-label="已选品牌与套餐对比，可横向滚动" hidden><table class="compare-table"><caption>参考价格未计优惠；同列可以切换档位。手机端可横向滑动。</caption><thead id="compare-head"></thead><tbody id="compare-body"></tbody></table></div><div class="dossier-evidence"><strong>比较结果该怎么使用</strong><p>价格和容量来自有引用的第三方参考资料；是否当前在售、实际倍率、客户端与设备限制仍需到站核对。AI 与流媒体没有本站实测。推广按钮使用站长指定链接，存在商业关系。</p></div><noscript><p class="notice">互动筛选需要 JavaScript。下方静态方案表和全部品牌详情可以直接阅读。</p></noscript></section>
<script>
import {price,traffic,type Airport,type Plan} from '../data/airports';
type CompareBrand=Airport&{positioning:string;audience:string;couponLabel:string};
const root=document.querySelector<HTMLElement>('#comparison')!;
const brands=JSON.parse(root.dataset.brands!) as CompareBrand[];
const inputs=[...root.querySelectorAll<HTMLInputElement>('input[name="compare-brand"]')];
const search=root.querySelector<HTMLInputElement>('[name=brand-search]')!,budget=root.querySelector<HTMLSelectElement>('[name=brand-budget]')!,coupon=root.querySelector<HTMLInputElement>('[name=coupon-only]')!;
const differences=root.querySelector<HTMLInputElement>('#compare-differences')!,status=root.querySelector('#compare-status')!,head=root.querySelector('#compare-head')!,body=root.querySelector('#compare-body')!;
const chosenPlans=new Map<string,string>();
const planOf=(a:CompareBrand)=>a.plans.find(p=>p.id===chosenPlans.get(a.slug))??a.plans[0];
const selected=()=>brands.filter(a=>inputs.some(i=>i.checked&&i.value===a.slug));
const textElement=(tag:string,text:string,className='')=>{const node=document.createElement(tag);node.textContent=text;if(className)node.className=className;return node};
function filterBrands(){const q=search.value.trim().toLocaleLowerCase(),cap=budget.value==='all'?Infinity:Number(budget.value);let visible=0;for(const a of brands){const label=root.querySelector<HTMLElement>(`[data-picker-brand="${a.slug}"]`)!;const checked=inputs.find(i=>i.value===a.slug)!.checked;const fits=(label.dataset.search!.includes(q))&&(cap===Infinity||(a.plans[0]!==undefined&&a.plans[0].price<=cap))&&(!coupon.checked||Boolean(a.coupon));label.hidden=!(checked||fits);if(!label.hidden)visible++}root.querySelector('.brand-filter-status')!.textContent=`当前显示 ${visible} / 29 家；已选品牌始终显示。${visible===0?'请调整关键词或筛选条件。':''}`}
function updateURL(){const url=new URL(location.href);const chosen=selected();if(chosen.length){url.searchParams.set('brands',chosen.map(a=>a.slug).join(','));const plans=chosen.filter(a=>chosenPlans.has(a.slug)).map(a=>a.slug+':'+chosenPlans.get(a.slug));if(plans.length)url.searchParams.set('plans',plans.join(','));else url.searchParams.delete('plans')}else{url.searchParams.delete('brands');url.searchParams.delete('plans')}history.replaceState(null,'',url);}
function remove(slug:string){inputs.find(input=>input.value===slug)!.checked=false;chosenPlans.delete(slug);update();const target=inputs.find(input=>input.value===slug)!;if(target.closest<HTMLElement>('label')!.hidden)search.focus();else target.focus()}
function values(a:CompareBrand,p:Plan|undefined){return [p?`${p.name}：${price(p)}`:'当前报价与套餐未核实',traffic(p),a.positioning,a.coupon?`${a.coupon} · ${a.couponLabel}`:a.couponLabel,a.advantages.join('；'),a.sourceNotes,a.audience,'客户端、协议、设备与倍率尚未核实','AI / 流媒体无本站实测',`第三方参考 · 查询 ${a.lastVerified}`]}
const labels=['参考方案价格','标称月容量','选择侧重点','指定优惠码','资料所示优点','关键局限','适合的需求','客户端与计费条件','应用实测状态','来源与查询日期'];
function update(){const chosen=selected(),active=chosen.length>=2;inputs.forEach(input=>input.disabled=chosen.length>=4&&!input.checked);root.querySelector('#compare-count')!.textContent=`已选择 ${chosen.length} / 4 家`;status.textContent=active?`已选择 ${chosen.length} / 4 家。下方结果随各列套餐变化；${differences.checked?'仅显示不同项。':'展示十个核对维度。'}`:chosen.length===1?'再选 1 家即可开始并排比较。':'请选择至少 2 家品牌。';root.querySelector<HTMLElement>('#compare-empty')!.hidden=active;root.querySelector<HTMLElement>('#compare-output')!.hidden=!active;root.querySelector<HTMLButtonElement>('#compare-share')!.disabled=!active;root.querySelector<HTMLButtonElement>('#compare-jump')!.disabled=!active;head.replaceChildren();body.replaceChildren();const tray=root.querySelector('.selected-tray')!;tray.replaceChildren();chosen.forEach(a=>{const button=textElement('button',a.name+' ×','selected-chip') as HTMLButtonElement;button.type='button';button.setAttribute('aria-label','取消选择 '+a.name);button.addEventListener('click',()=>remove(a.slug));tray.append(button)});if(active){const row=document.createElement('tr');const first=textElement('th','比较维度');first.setAttribute('scope','col');row.append(first);chosen.forEach(a=>{const th=document.createElement('th');th.scope='col';const link=document.createElement('a');link.href=`/airport/${a.slug}/`;link.className='compare-brand-link';link.textContent=a.name;const removeButton=textElement('button','移除','compare-remove') as HTMLButtonElement;removeButton.type='button';removeButton.setAttribute('aria-label','移除 '+a.name);removeButton.addEventListener('click',()=>remove(a.slug));th.append(link,removeButton);if(a.plans.length){const label=document.createElement('label');label.className='compare-plan-label';label.append(textElement('span','对比的具体档位'));const select=document.createElement('select');select.setAttribute('aria-label','选择 '+a.name+' 的套餐');a.plans.forEach(p=>{const option=document.createElement('option');option.value=p.id;option.textContent=`${p.name} · ¥${p.price} · ${p.trafficGB??'未知'} ${p.trafficUnit??'GB'}`;option.selected=p.id===planOf(a)?.id;select.append(option)});select.addEventListener('change',()=>{chosenPlans.set(a.slug,select.value);update()});label.append(select);th.append(label)}else th.append(textElement('small','当前未列价，不以历史同名套餐代替'));const details=document.createElement('a');details.href=`/airport/${a.slug}/`;details.className='table-button';details.textContent='查看品牌详情 →';th.append(details);const offer=document.createElement('a');offer.href=a.affiliateUrl;offer.target='_blank';offer.rel='sponsored nofollow noopener noreferrer';offer.textContent='当前套餐（推广）↗';offer.className='compare-offer';th.append(offer);row.append(th)});head.append(row);labels.forEach((label,index)=>{const cells=chosen.map(a=>values(a,planOf(a))[index]);if(differences.checked&&index!==9&&cells.every(text=>text===cells[0]))return;const row=document.createElement('tr');const th=textElement('th',label);th.setAttribute('scope','row');row.append(th);chosen.forEach((a,i)=>{const td=textElement('td',cells[i]);if(index===9){const refs=textElement('div','','compare-sources');a.sources.forEach((source,j)=>{const link=document.createElement('a');link.href=source;link.target='_blank';link.rel='noopener noreferrer';link.textContent=`资料 ${j+1} · ${new URL(source).hostname}`;refs.append(link)});td.append(refs)}row.append(td)});body.append(row)});root.style.setProperty('--compare-columns',String(chosen.length))}updateURL();filterBrands();}
inputs.forEach(input=>input.addEventListener('change',update));[search,budget,coupon].forEach(input=>input.addEventListener(input===search?'input':'change',filterBrands));differences.addEventListener('change',update);
root.querySelector('#compare-jump')!.addEventListener('click',()=>root.querySelector('#compare-output')!.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'}));
root.querySelector('#compare-clear')!.addEventListener('click',()=>{inputs.forEach(input=>input.checked=false);chosenPlans.clear();differences.checked=false;update();root.querySelector('#share-feedback')!.textContent=''});
root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(button=>button.addEventListener('click',()=>{const slugs=button.dataset.preset!.split(',');inputs.forEach(input=>input.checked=slugs.includes(input.value));chosenPlans.clear();const need=Number(button.dataset.need??0);if(need)slugs.forEach(slug=>{const a=brands.find(a=>a.slug===slug)!;const p=a.plans.filter(p=>(p.trafficGB??0)>=need).sort((p,q)=>p.price-q.price)[0];if(p)chosenPlans.set(slug,p.id)});update();root.querySelector('#compare-output')!.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'})}));
root.querySelector('#compare-share')!.addEventListener('click',async()=>{const feedback=root.querySelector('#share-feedback')!;const fallback=root.querySelector<HTMLInputElement>('.share-url')!;try{await navigator.clipboard.writeText(location.href);feedback.textContent='对比链接已复制，包含当前品牌与档位选择。';fallback.hidden=true}catch{fallback.hidden=false;fallback.value=location.href;fallback.focus();fallback.select();feedback.textContent='请手动复制下方对比链接。'}});
const url=new URL(location.href),requested=[...new Set((url.searchParams.get('brands')??'').split(','))].filter(slug=>brands.some(a=>a.slug===slug)).slice(0,4);inputs.forEach(input=>input.checked=requested.includes(input.value));(url.searchParams.get('plans')??'').split(',').forEach(pair=>{const [slug,id]=pair.split(':');if(requested.includes(slug)&&brands.find(a=>a.slug===slug)?.plans.some(p=>p.id===id))chosenPlans.set(slug,id)});update();
</script>
