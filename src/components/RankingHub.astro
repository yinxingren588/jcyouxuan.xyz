import {airports} from '../data/airports';
const first=airports.flatMap(a=>a.plans[0]?[a.plans[0]]:[]);const low=Math.min(...first.map(p=>p.price)),high=Math.max(...first.map(p=>p.price));
const views=[['overall','站长推荐目录','29 家品牌按指定顺序展示，读清各自的推荐理由和局限。','目录顺序'],['budget','月付预算比较','输入预算和容量条件，查看各家已收录的匹配月付参考档。','筛选工具'],['traffic','流量档位比较','按百 GB、三百 GB或更高需求匹配容量，保留单位与周期。','容量匹配'],['value','套餐成本测算','用自己核实的价格、容量和倍率计算预算，避免错算实际可用量。','计算工具'],['stable','晚高峰稳定性核查','用统一记录模板观察真实任务，不把线路名称写成稳定性得分。','方法与模板']];
---
<div class="page-body editorial-hub"><section class="section-intro"><div><span class="eyebrow">DIRECTORY, DATA & DECISIONS</span><h2>能比较的维度，分别说明</h2><p>目录顺序、参考费用与容量是不同维度。这里把可以使用的比较工具做好，同时明确没有经过验证的性能结论。</p></div><div class="hub-stat"><strong>¥{low}–{high}</strong><span>已收录首档参考月费区间</span><small>非全市场最低价 · 非当前结算价</small></div></section><div class="ranking-view-grid">{views.map(([key,title,body,label])=><article class="ranking-view"><span class="tag">{label}</span><h2>{title}</h2><p>{body}</p><a class="button secondary" href={`/ranking/${key}/`}>打开{label} →</a></article>)}</div><section class="criteria-box"><h2>怎么读这些结果</h2><div class="grid three"><div><strong>价格 / 容量</strong><p>引用各品牌公开参考资料。筛选结果不保证当前在售，优惠未计入。</p></div><div><strong>推荐 / 展示顺序</strong><p>站长指定目录，存在商业推广关系；不伪装为测试分数。</p></div><div><strong>速度 / 稳定性</strong><p>需要真实网络和原始记录。本期没有合格实测，不发布推测名次。</p></div></div></section><div class="dossier-next"><a class="button" href="/compare/">挑选 2–4 家做对比 →</a><a class="button secondary" href="/editorial-policy/">查看数据与推广政策</a></div></div>
