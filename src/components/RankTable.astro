---
import {airports,price,traffic} from '../data/airports';
import {brandEditorial} from '../data/brand-editorial';
const {kind='budget'}=Astro.props as {kind?:string};const need=kind==='quota'?300:0;
const data=airports.map(a=>({...a,positioning:brandEditorial[a.slug].positioning}));
const initial=airports.flatMap(a=>{const p=need?a.plans.filter(p=>p.trafficUnit!=='GiB'&&(p.trafficGB??0)>=need).sort((p,q)=>p.price-q.price)[0]:a.plans[0];return !need||p?[{a,p}]:[]});
---
<section class="rank-browser" data-rank-browser data-brands={JSON.stringify(data)}><div class="filter-toolbar"><label>月付参考预算<select name="budget"><option value="all">不限预算</option><option value="20">不超过 ¥20</option><option value="25">不超过 ¥25</option><option value="40">不超过 ¥40</option><option value="70">不超过 ¥70</option><option value="100">不超过 ¥100</option></select></label><label>至少需要的月容量<select name="capacity"><option value="0" selected={need===0}>不限容量</option><option value="100">100GB</option><option value="200">200GB</option><option value="300" selected={need===300}>300GB</option><option value="500">500GB</option><option value="1000">1000GB</option></select></label><label>展示方式<select name="sort"><option value="directory">站长目录顺序</option><option value="price">参考月费从低到高</option><option value="traffic">GB 容量从高到低</option></select></label><button class="button secondary" type="button" data-reset>重置筛选</button></div><p class="filter-status" aria-live="polite">{initial.length} 家符合当前参考条件。筛选只比较价格与容量，不代表质量排名。</p><div class="table-scroll" tabindex="0" role="region" aria-label="可筛选的月付参考方案"><table class="rank-table"><caption>默认保持站长顺序；筛选结果取该品牌满足容量要求的已收录低价月付档</caption><thead><tr><th scope="col">目录 / 品牌</th><th scope="col">匹配参考档</th><th scope="col">参考月费</th><th scope="col">标称月容量</th><th scope="col">选择重点</th><th scope="col">下一步</th></tr></thead><tbody>{initial.map(({a,p})=><tr><th scope="row"><span class="order-number">{String(a.order).padStart(2,'0')}</span><a href={`/airport/${a.slug}/`}>{a.name}</a></th><td>{p?.name??'尚未列价'}</td><td>{price(p)}</td><td>{traffic(p)}</td><td>{brandEditorial[a.slug].positioning}</td><td><a class="table-button" href={`/airport/${a.slug}/`}>查看详情 →</a><a class="table-button quiet" href={`/compare/?brands=${a.slug}`}>加入对比</a></td></tr>)}</tbody></table></div><p class="rank-empty empty" hidden>没有符合当前预算和容量的已收录方案。请调整条件；未收录不表示当前面板没有其他套餐。</p><p class="muted">启用 GB 容量筛选或容量排序时，不混入 GiB 口径与未知容量。优惠未计入，倍率与当前在售条件仍需确认。</p></section>
<script>
import type {Airport} from '../data/airports';
import {price,traffic} from '../data/airports';
document.querySelectorAll<HTMLElement>('[data-rank-browser]').forEach(root=>{const brands=JSON.parse(root.dataset.brands!) as (Airport&{positioning:string})[];const budget=root.querySelector<HTMLSelectElement>('[name=budget]')!,capacity=root.querySelector<HTMLSelectElement>('[name=capacity]')!,sort=root.querySelector<HTMLSelectElement>('[name=sort]')!;const original=capacity.value;const body=root.querySelector('tbody')!;const update=()=>{const limit=budget.value==='all'?Infinity:Number(budget.value),need=Number(capacity.value);const gbOnly=need>0||sort.value==='traffic';const rows=brands.flatMap(a=>{const valid=a.plans.filter(p=>p.period==='month'&&p.currency==='CNY'&&(!gbOnly||p.trafficUnit!=='GiB')&&(p.trafficGB??0)>=need&&p.price<=limit).sort((p,q)=>p.price-q.price);const p=valid[0];return p||(!need&&limit===Infinity&&!gbOnly&&!a.plans.length)?[{a,p}]:[]});if(sort.value==='price')rows.sort((x,y)=>(x.p?.price??Infinity)-(y.p?.price??Infinity)||x.a.order-y.a.order);if(sort.value==='traffic')rows.sort((x,y)=>(y.p?.trafficGB??-1)-(x.p?.trafficGB??-1)||x.a.order-y.a.order);body.replaceChildren();const cell=(text:string,tag='td')=>{const node=document.createElement(tag);node.textContent=text;return node};rows.forEach(({a,p})=>{const tr=document.createElement('tr');const th=cell(`${String(a.order).padStart(2,'0')} · `,'th');th.setAttribute('scope','row');const link=document.createElement('a');link.href=`/airport/${a.slug}/`;link.textContent=a.name;th.append(link);tr.append(th,cell(p?.name??'尚未列价'),cell(price(p)),cell(traffic(p)),cell(a.positioning));const actions=cell('');for(const [label,href,quiet] of [['查看详情 →',`/airport/${a.slug}/`,false],['加入对比',`/compare/?brands=${a.slug}`,true]] as const){const a=document.createElement('a');a.className='table-button'+(quiet?' quiet':'');a.textContent=label;a.href=href;actions.append(a)}tr.append(actions);body.append(tr)});root.querySelector<HTMLElement>('.rank-empty')!.hidden=rows.length>0;root.querySelector('.filter-status')!.textContent=`${rows.length} 家符合当前参考条件。${sort.value==='directory'?'按站长目录顺序展示。':sort.value==='price'?'仅按所选参考档月费升序，不代表质量。':'仅按 GB 口径标称容量降序，不代表性能。'}`;};[budget,capacity,sort].forEach(control=>control.addEventListener('change',update));root.querySelector('[data-reset]')!.addEventListener('click',()=>{budget.value='all';capacity.value=original;sort.value='directory';update()});});
</script>
