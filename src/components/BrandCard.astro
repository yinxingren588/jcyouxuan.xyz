---
import {traffic,type Airport,type Plan} from '../data/airports';
import {brandEditorial} from '../data/brand-editorial';
import Promotion from './Promotion.astro';
import {brandEvidence} from '../data/brand-evidence';
const {airport:a,plan}=Astro.props as {airport:Airport;plan?:Plan};const p=plan??a.plans[0],e=brandEditorial[a.slug];
---
<article class="card brand-card" data-brand={a.slug} data-plan={p?.id}><div class="brand-head"><span class="brand-icon" style={`--brand:${a.color}`} aria-hidden="true">{String(a.order).padStart(2,'0')}</span><div><h3><a href={`/airport/${a.slug}/`}>{a.name}</a></h3><span class="badge">套餐资料 · 选择分析</span></div></div><p class="brand-focus">{e.positioning}</p><div class="stats"><div><strong>{p?'¥'+p.price:'待核实'}</strong><small>{p?p.name+' · 参考标价':'同名资料关联待确认'}</small></div><div><strong>{p?.trafficGB??'—'}</strong><small>{traffic(p)}</small></div></div><p class="card-price-status">参考档位 · 当前在售未确认</p><p class="brand-summary">{e.deck}</p><ul class="brand-benefits">{a.advantages.map(text=><li>{text}</li>)}</ul><a class="card-evidence-link" href={`/airport/${a.slug}/#evidence`}>{brandEvidence[a.slug].conflicts.length?'查看套餐差异与核对项':'查看套餐条件与核对项'} →</a><Promotion airport={a} compact/><a class="button detail-button" href={`/airport/${a.slug}/`} aria-label={`查看品牌详情：${a.name}`}><span>查看品牌详情</span><span aria-hidden="true">→</span></a><small class="detail-button-hint">套餐解读 · 适合人群 · 优点与局限 · 条件</small></article>
