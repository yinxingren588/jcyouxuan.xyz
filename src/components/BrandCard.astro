---
import {traffic,type Airport} from '../data/airports';
import Promotion from './Promotion.astro';
const {airport:a}=Astro.props as {airport:Airport};const p=a.plans[0];
---
<article class="card brand-card" data-brand={a.slug}><div class="brand-head"><span class="brand-icon" style={`--brand:${a.color}`} aria-hidden="true">{String(a.order).padStart(2,'0')}</span><div><h3>{a.name}</h3><span class="badge">站长推荐顺序 · 资料分析</span></div></div><p class="brand-focus">{a.focus}</p><div class="stats"><div><strong>{p?'¥'+p.price:'待核实'}</strong><small>{p?'选定月付档 · 参考标价':'同名资料关联待确认'}</small></div><div><strong>{p?.trafficGB??'—'}</strong><small>{traffic(p)}</small></div></div><p class="recommendation">{a.recommendation}</p><ul>{a.advantages.map(text=><li>{text}</li>)}</ul><Promotion airport={a} compact/><a class="detail" href={`/airport/${a.slug}/`}><span>推荐原因、局限与来源</span><span aria-hidden="true">↗</span></a></article>
