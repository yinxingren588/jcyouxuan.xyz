---
import {getCollection,render,type CollectionEntry} from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import BrandTable from '../components/BrandTable.astro';
import BrandDetail from '../components/BrandDetail.astro';
import BrandAnalysis from '../components/BrandAnalysis.astro';
import Ranking from '../components/Ranking.astro';
import Compare from '../components/Compare.astro';
import RecommendationHub from '../components/RecommendationHub.astro';
import ScenarioPage from '../components/ScenarioPage.astro';
import RankingHub from '../components/RankingHub.astro';
import {pages,type Page} from '../data/pages';
import {airports} from '../data/airports';
import {legalCopy} from '../data/topic-copy';
import BlogHub from '../components/BlogHub.astro';
import {blogArchivePages,blogCategories,readingMinutes,relatedArticles} from '../data/blog';
export async function getStaticPaths(){const articles=await getCollection('articles',a=>!a.data.draft);return [...[...pages,...blogArchivePages(articles)].map(page=>({params:{path:page.path},props:{page}})),...articles.map(article=>({params:{path:`${article.data.section}/${article.data.slug}`},props:{page:{path:`${article.data.section}/${article.data.slug}`,title:article.data.title,description:article.data.description,type:'article',parent:article.data.section},article}}))];}
interface Props {page:Page;article?:CollectionEntry<'articles'>}
const {page,article}=Astro.props;
const articles=await getCollection('articles',a=>!a.data.draft);
const rendered=article?await render(article):undefined;
const Content=rendered?.Content;
const parent=pages.find(p=>p.path===page.parent);
const crumbs=[...(parent?[{name:parent.title,url:`/${parent.path}/`}]:[]),{name:page.title,url:`/${page.path}/`}];
const airport=airports.find(a=>a.slug===page.key);
const related=article?relatedArticles(article,articles):[];
const articleCategory=blogCategories.find(c=>c.id===article?.data.category);
const schema:Record<string,unknown>[]=article?[{'@context':'https://schema.org','@type':article.data.section==='blog'?'BlogPosting':'Article',headline:page.title,description:page.description,datePublished:article.data.published.toISOString(),dateModified:article.data.updated.toISOString(),author:{'@type':'Organization',name:'机场优选',url:'https://jcyouxuan.xyz/about/'},mainEntityOfPage:`https://jcyouxuan.xyz/${page.path}/`}]:[];
if(['brands','reviews'].includes(page.type))schema.push({'@context':'https://schema.org','@type':'ItemList',itemListElement:airports.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:`https://jcyouxuan.xyz/${page.type==='reviews'?'review':'airport'}/${a.slug}/`}))});
if(page.type==='ranking'&&page.key==='overall')schema.push({'@context':'https://schema.org','@type':'ItemList',name:'站长指定推荐顺序',itemListElement:airports.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:`https://jcyouxuan.xyz/airport/${a.slug}/`}))});
---
<Layout title={page.title} description={page.description} noindex={page.noindex} breadcrumbs={crumbs} schema={schema}>
<div class="wrap"><div class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a>{crumbs.map((b,i)=><span> / {i===crumbs.length-1?<span aria-current="page">{page.type==='article'?'正文':b.name}</span>:<a href={b.url}>{b.name}</a>}</span>)}</div><header class="page-head"><p class="eyebrow">{page.type==='article'?'KNOWLEDGE & GUIDES':page.type==='compare'?'SIDE BY SIDE':'CONNECTION, CONSIDERED.'}</p><h1>{page.title}</h1><p>{page.description}</p>{article&&<p class="hero-note">机场优选 · {articleCategory&&<a href={`/blog/category/${articleCategory.id}/`}>{articleCategory.name} · </a>}约 {readingMinutes(article.body)} 分钟 · 发布 {article.data.published.toISOString().slice(0,10)} · 更新 {article.data.updated.toISOString().slice(0,10)}</p>}</header>
{page.type==='article'&&Content&&article&&<div class="article-layout"><article class="prose"><Content/><h2 id="references">参考来源与核验边界</h2><p>参考资料用于核对正文中对应的概念、产品规则或引用信息；方法与计算示例由本站整理。适用范围与资料冲突见正文，未提供原始观察记录的内容不代表本站网络实测。</p><ul class="source-list">{article.data.sources.map(s=><li><a href={s} rel="noopener noreferrer">{s}</a></li>)}</ul><h2 id="related">相关内容</h2><ul>{related.map(a=><li><a href={`/${a.data.section}/${a.data.slug}/`}>{a.data.title}</a></li>)}</ul><p><a href="/recommend/">返回需求专题</a> · <a href="/editorial-policy/">编辑与更正标准</a></p></article><aside class="sidebar"><div class="sidebar-inner"><h2>文章目录</h2>{rendered?.headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#references">参考来源</a><a href="#related">相关内容</a><h2 class="more-space">下一步</h2><a href="/compare/">核对候选品牌</a><a href="/glossary/">查询基础概念</a></div></aside></div>}
{page.type==='recommend'&&<RecommendationHub/>}
{page.type==='topic'&&<ScenarioPage kind={page.key!}/> }
{page.type==='rankings'&&<RankingHub/>}
{page.type==='ranking'&&<Ranking kind={page.key!}/>}
{page.type==='brands'&&<div class="page-body"><div class="notice">29 个指定品牌 · 11 个指定优惠码 · 按站长提供顺序展示。每家单独说明推荐理由、参考来源和局限，当前无本站网络实测。</div><div class="grid three">{airports.map(a=><BrandCard airport={a}/>)}</div></div>}
{page.type==='reviews'&&<div class="page-body"><div class="notice">本栏目逐家分析费用、容量与适用条件。价格引用第三方公开资料，未通过当前结算复核；本站含推广关系，推荐依据不等于网络实测。</div><div class="grid three">{airports.map(a=><a class="article-card" href={`/review/${a.slug}/`}><span class="tag">资料分析 · 非实测</span><h2 style="font-size:22px">{a.name}</h2><p>{a.description}</p><time datetime="2026-10-16">整理 2026-10-16</time></a>)}</div></div>}
{page.type==='brand'&&airport&&<BrandDetail airport={airport}/>}
{page.type==='review'&&airport&&<BrandAnalysis airport={airport}/>}
{page.type==='compare'&&<div class="page-body"><Compare/><details class="static-comparison"><summary>查看全部 29 家的静态参考表 <span>无需交互也可阅读 ↓</span></summary><p class="muted">每家仅展示已收录首档，完整套餐与来源在品牌详情。默认目录顺序不代表性能。</p><BrandTable/></details></div>}
{page.type==='blog'&&<BlogHub articles={articles} archiveKey={page.key}/>}
{['guides','glossary'].includes(page.type)&&<div class="page-body"><div class="grid three">{articles.filter(a=>a.data.section===page.type).map(a=><a class="article-card" href={`/${a.data.section}/${a.data.slug}/`}><span class="tag">{page.type==='guides'?'使用教程':'基础知识'}</span><h2 style="font-size:21px">{a.data.title}</h2><p>{a.data.description}</p><time datetime="2026-10-16">2026.10.16</time></a>)}</div><div class="notice">教程与百科相互关联。需要比较产品事实时，可继续查看<a href="/compare/" class="text-link">品牌比较</a>；所有资料采用<a href="/editorial-policy/" class="text-link">公开证据标准</a>。</div></div>}
{page.type==='legal'&&<article class="prose page-body" style="max-width:800px">{legalCopy[page.key!].map(s=><section><h2>{s.heading}</h2><p>{s.text}</p></section>)}{page.key==='contact'&&<p><a href="https://github.com/yinxingren588/jcyouxuan.xyz/issues">前往 GitHub 提交纠错或反馈 ↗</a></p>}<p class="hero-note">生效与最后更新：2026-10-16。</p><p><a href="/about/">关于本站</a> · <a href="/editorial-policy/">编辑政策</a> · <a href="/contact/">联系与纠错</a></p></article>}
{page.type==='404'&&<div class="page-body"><div class="empty"><p>链接可能已更改，也可能输入有误。</p><div class="buttons" style="justify-content:center"><a class="button" href="/">返回首页</a><a class="button secondary" href="/guides/">浏览教程</a></div></div></div>}
</div></Layout>
