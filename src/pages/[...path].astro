---
import {getCollection,render,type CollectionEntry} from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import BrandTable from '../components/BrandTable.astro';
import BrandDetail from '../components/BrandDetail.astro';
import BrandAnalysis from '../components/BrandAnalysis.astro';
import Ranking from '../components/Ranking.astro';
import Compare from '../components/Compare.astro';
import {pages,type Page} from '../data/pages';
import {airports} from '../data/airports';
import {topics} from '../data/site';
import {topicCopy,legalCopy} from '../data/topic-copy';
export async function getStaticPaths(){const articles=await getCollection('articles',a=>!a.data.draft);return [...pages.map(page=>({params:{path:page.path},props:{page}})),...articles.map(article=>({params:{path:`${article.data.section}/${article.data.slug}`},props:{page:{path:`${article.data.section}/${article.data.slug}`,title:article.data.title,description:article.data.description,type:'article',parent:article.data.section},article}}))];}
interface Props {page:Page;article?:CollectionEntry<'articles'>}
const {page,article}=Astro.props;
const articles=await getCollection('articles',a=>!a.data.draft);
const rendered=article?await render(article):undefined;
const Content=rendered?.Content;
const parent=pages.find(p=>p.path===page.parent);
const crumbs=[...(parent?[{name:parent.title,url:`/${parent.path}/`}]:[]),{name:page.title,url:`/${page.path}/`}];
const airport=airports.find(a=>a.slug===page.key);
const copy=page.type==='topic'?topicCopy[page.key!]:undefined;
const related=article?articles.filter(a=>a.id!==article.id&&a.data.tags.some(t=>article.data.tags.includes(t))).slice(0,3):[];
const schema:Record<string,unknown>[]=article?[{'@context':'https://schema.org','@type':article.data.section==='blog'?'BlogPosting':'Article',headline:page.title,description:page.description,datePublished:article.data.published.toISOString(),dateModified:article.data.updated.toISOString(),author:{'@type':'Organization',name:'机场优选',url:'https://jcyouxuan.xyz/about/'},mainEntityOfPage:`https://jcyouxuan.xyz/${page.path}/`}]:[];
if(['brands','reviews'].includes(page.type))schema.push({'@context':'https://schema.org','@type':'ItemList',itemListElement:airports.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:`https://jcyouxuan.xyz/${page.type==='reviews'?'review':'airport'}/${a.slug}/`}))});
if(page.type==='ranking'&&page.key==='quota')schema.push({'@context':'https://schema.org','@type':'ItemList',itemListElement:[{name:'Proton VPN',slug:'proton-vpn'},{name:'Windscribe',slug:'windscribe'},{name:'TunnelBear',slug:'tunnelbear'}].map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:`https://jcyouxuan.xyz/airport/${a.slug}/`}))});
---
<Layout title={page.title} description={page.description} noindex={page.noindex} breadcrumbs={crumbs} schema={schema}>
<div class="wrap"><div class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a>{crumbs.map((b,i)=><span> / {i===crumbs.length-1?<span aria-current="page">{page.type==='article'?'正文':b.name}</span>:<a href={b.url}>{b.name}</a>}</span>)}</div><header class="page-head"><p class="eyebrow">{page.type==='article'?'KNOWLEDGE & GUIDES':page.type==='compare'?'SIDE BY SIDE':'CONNECTION, CONSIDERED.'}</p><h1>{page.title}</h1><p>{page.description}</p>{article&&<p class="hero-note">机场优选 · 发布 {article.data.published.toISOString().slice(0,10)} · 更新 {article.data.updated.toISOString().slice(0,10)}</p>}</header>
{page.type==='article'&&Content&&article&&<div class="article-layout"><article class="prose"><Content/><h2 id="references">参考来源与核验边界</h2><p>以下为相关概念或产品说明的官方来源。本页的方法性建议由本站整理，不是对特定网络的实测结论。</p><ul class="source-list">{article.data.sources.map(s=><li><a href={s} rel="noopener noreferrer">{s}</a></li>)}</ul><h2 id="related">相关内容</h2><ul>{related.map(a=><li><a href={`/${a.data.section}/${a.data.slug}/`}>{a.data.title}</a></li>)}</ul><p><a href="/recommend/">返回需求专题</a> · <a href="/editorial-policy/">编辑与更正标准</a></p></article><aside class="sidebar"><div class="sidebar-inner"><h2>文章目录</h2>{rendered?.headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#references">参考来源</a><a href="#related">相关内容</a><h2 class="more-space">下一步</h2><a href="/compare/">核对候选品牌</a><a href="/glossary/">查询基础概念</a></div></aside></div>}
{page.type==='recommend'&&<div class="page-body"><div class="notice">先明确预算与任务，再核对来源。当前品牌库为商业 VPN；缺少已核验的代理订阅机场资料，因此不发布机场购买名单。</div><div class="grid three">{topics.map(t=><a class="topic-card" href={`/recommend/${t.slug}/`}><span class="topic-icon">{t.icon}</span><div><h2 style="font-size:18px">{t.name}</h2><p>{t.description}</p></div></a>)}</div><h2 class="more-space">先建立一份候选清单</h2><BrandTable/><p class="more-space"><a class="text-link" href="/blog/choose-a-service/">阅读完整选择流程 →</a></p></div>}
{page.type==='topic'&&copy&&<div class="article-layout"><article class="prose"><div class="notice"><strong>快速结论</strong><p>{copy.answer}</p></div><h2 id="priorities">优先检查的三个问题</h2><ol>{copy.checks.map(c=><li>{c}</li>)}</ol><h2 id="evidence">资料能告诉你什么</h2><p>{copy.body}</p><h2 id="steps">可执行的选择步骤</h2><p>记录设备、预算、目标任务和接入网络。用清单排除不满足基本条件的方案，再依据官方来源核对价格与限制。涉及质量、稳定性或解锁的结论，必须保留测试日期和环境。</p><p>首次体验以低承诺方案开始。每次只改变一个条件，保留成功与失败记录；购买前重新核对当前条款，避免把过期资料当作承诺。</p><h2 id="next">接下来阅读</h2><ul>{copy.links.map(l=><li><a href={l.url}>{l.title}</a></li>)}</ul><p>所有主题都可以回到<a href="/ranking/">数据与榜单</a>检查准入规则，并用<a href="/compare/">比较工具</a>核对候选事实。</p><h2 id="scope">更新与边界</h2><p>2026-10-16 编辑整理。本专题提供选择方法，不构成品牌性能背书。官方资料与实际测试遵循<a href="/editorial-policy/">不同证据标准</a>。</p></article><aside class="sidebar"><div class="sidebar-inner"><h2>相关专题</h2>{topics.filter(t=>t.slug!==page.key).map(t=><a href={`/recommend/${t.slug}/`}>{t.name}</a>)}<h2 class="more-space">核对资料</h2><a href="/airport/">品牌资料库</a><a href="/ranking/">榜单规则</a></div></aside></div>}
{page.type==='rankings'&&<div class="page-body"><div class="notice">当前可以发布的比较范围是免费入门费用与基础流量额度。综合、性价比与稳定性榜的代码及方法已经建立，等待合格数据。</div><div class="grid three">{pages.filter(p=>p.type==='ranking').map(p=><a class="article-card" href={`/${p.path}/`}><span class="tag">{p.noindex?'待核验 · 暂无名次':'官方资料比较'}</span><h2 style="font-size:20px">{p.title}</h2><p>{p.description}</p><span class="text-link">查看数据与方法 →</span></a>)}</div><h2 class="more-space">全部公开方案</h2><BrandTable/></div>}
{page.type==='ranking'&&<Ranking kind={page.key!}/>}
{page.type==='brands'&&<div class="page-body"><div class="notice">5 家商业 VPN · 0 家已核验订阅机场 · 0 份网络实测。缺少的资料统一显示“尚未核实”。</div><div class="grid three">{airports.map(a=><BrandCard airport={a}/>)}</div></div>}
{page.type==='reviews'&&<div class="page-body"><div class="notice">本栏目是独立资料评析，不是网络实测报告。价格等事实引用官网；适合人群与取舍属于编辑判断。</div><div class="grid three">{airports.map(a=><a class="article-card" href={`/review/${a.slug}/`}><span class="tag">资料分析 · 非实测</span><h2 style="font-size:22px">{a.name}</h2><p>{a.description}</p><time datetime="2026-10-16">核验 2026-10-16</time></a>)}</div></div>}
{page.type==='brand'&&airport&&<BrandDetail airport={airport}/>}
{page.type==='review'&&airport&&<BrandAnalysis airport={airport}/>}
{page.type==='compare'&&<div class="page-body"><Compare/><div class="notice">空白字段表示尚未核实。不同币种、周期和不限流量方案不会被自动折算为质量排名。资料核验：2026-10-16。</div><h2 class="more-space">静态公开资料</h2><BrandTable/></div>}
{['guides','blog','glossary'].includes(page.type)&&<div class="page-body"><div class="grid three">{articles.filter(a=>a.data.section===page.type).map(a=><a class="article-card" href={`/${a.data.section}/${a.data.slug}/`}><span class="tag">{page.type==='guides'?'使用教程':page.type==='blog'?'选择方法':'基础知识'}</span><h2 style="font-size:21px">{a.data.title}</h2><p>{a.data.description}</p><time datetime="2026-10-16">2026.10.16</time></a>)}</div><div class="notice">教程与百科相互关联。需要比较产品事实时，可继续查看<a href="/compare/" class="text-link">品牌比较</a>；所有资料采用<a href="/editorial-policy/" class="text-link">公开证据标准</a>。</div></div>}
{page.type==='legal'&&<article class="prose page-body" style="max-width:800px">{legalCopy[page.key!].map(s=><section><h2>{s.heading}</h2><p>{s.text}</p></section>)}{page.key==='contact'&&<p><a href="https://github.com/yinxingren588/jcyouxuan.xyz/issues">前往 GitHub 提交纠错或反馈 ↗</a></p>}<p class="hero-note">生效与最后更新：2026-10-16。</p><p><a href="/about/">关于本站</a> · <a href="/editorial-policy/">编辑政策</a> · <a href="/contact/">联系与纠错</a></p></article>}
{page.type==='404'&&<div class="page-body"><div class="empty"><p>链接可能已更改，也可能输入有误。</p><div class="buttons" style="justify-content:center"><a class="button" href="/">返回首页</a><a class="button secondary" href="/guides/">浏览教程</a></div></div></div>}
</div></Layout>
