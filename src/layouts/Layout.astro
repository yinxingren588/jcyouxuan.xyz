---
import '../styles/global.css';
import '../styles/ambient.css';
import '../styles/brands.css';
import AmbientBackground from '../components/AmbientBackground.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/editorial.css';
import '../styles/blog.css';
import {site} from '../data/site';
interface Props {title:string;description:string;noindex?:boolean;breadcrumbs?:{name:string;url:string}[];schema?:Record<string,unknown>[]}
const {title,description,noindex=false,breadcrumbs=[],schema=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).href;

const structured=[{'@context':'https://schema.org','@type':'Organization',name:site.name,url:site.url},{'@context':'https://schema.org','@type':'WebSite',name:site.name,url:site.url,inLanguage:'zh-CN'},...(breadcrumbs.length?[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'首页',url:'/'},...breadcrumbs].map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.url,site.url).href}))}]:[]),...schema];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · 机场优选</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex, follow':'index, follow'}/><meta property="og:locale" content="zh_CN"/><meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${site.url}/social.svg`}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={`${site.url}/social.svg`}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{import.meta.env.PUBLIC_BING_VERIFICATION&&<meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION}/>}<script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\u003c')}/></head>
<body><AmbientBackground/><a href="#main" class="skip">跳到主要内容</a><div class="topbar"><div class="wrap"><span>29 品牌精选 · 来源可查 · 推广透明</span><span>资料查询：2026.10.16</span></div></div><header class="header"><div class="wrap header-row"><a href="/" class="logo" aria-label="机场优选首页"><span class="logo-mark" aria-hidden="true">↗</span><span>机场优选<small>CONNECTION, CONSIDERED.</small></span></a><button class="icon-button menu-toggle" aria-expanded="false" aria-controls="navigation">菜单</button><Navigation/><div class="header-actions"><button class="icon-button" id="search-open" aria-label="搜索站内内容">⌕ <span class="search-label">搜索</span></button><button class="motion-toggle" id="motion-toggle" aria-label="暂停背景动画" aria-pressed="false" title="暂停背景动画"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path class="motion-pause" d="M6 4v10M12 4v10"/><path class="motion-play" d="m6 4 7 5-7 5Z"/></svg><span class="motion-label">暂停动效</span></button></div></div></header>
<main id="main" class:list={{'home-page':Astro.url.pathname==='/'}}><slot/></main>
<footer class="footer"><div class="wrap"><div class="footer-grid"><div><a href="/" class="logo"><span class="logo-mark" aria-hidden="true">↗</span>机场优选</a><p>把复杂的连接选择，变成有依据的决定。<br/>29 个品牌推荐依据、套餐参考和使用指南。</p></div><div><h3>探索内容</h3><a href="/recommend/">需求专题</a><a href="/ranking/">数据与榜单</a><a href="/compare/">品牌对比</a><a href="/glossary/">知识百科</a></div><div><h3>关于本站</h3><a href="/about/">关于我们</a><a href="/editorial-policy/">编辑政策</a><a href="/contact/">联系与纠错</a></div><div><h3>透明与责任</h3><a href="/privacy-policy/">隐私政策</a><a href="/disclaimer/">免责声明</a><a href="/sitemap-index.xml">Sitemap</a></div></div><div class="copyright"><span>© 2026 机场优选 · jcyouxuan.xyz</span><span>本站含推广链接 · 参考资料不等于实时报价或实测</span></div></div></footer>
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title"><div class="section-head"><h2 id="search-title">查找你需要的答案</h2><button class="icon-button" id="search-close" aria-label="关闭搜索">关闭</button></div><label for="site-search" class="sr-only">输入品牌、教程或术语</label><input id="site-search" type="search" placeholder="试试：暮光网络、优惠码、Windows" autocomplete="off"/><p class="muted" id="search-status" aria-live="polite">输入关键词搜索站内文章与品牌。</p><div class="search-results" id="search-results"></div></dialog>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle'); menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('#navigation')?.classList.toggle('open',open)});
const dialog=document.querySelector<HTMLDialogElement>('#search-dialog')!;document.querySelector('#search-open')?.addEventListener('click',()=>{dialog.showModal();document.querySelector<HTMLInputElement>('#site-search')?.focus()});document.querySelector('#search-close')?.addEventListener('click',()=>dialog.close());
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&dialog.open){event.preventDefault();dialog.close()}});
const motionButton=document.querySelector<HTMLButtonElement>('#motion-toggle')!;
const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
let motionPaused=false;
try{motionPaused=sessionStorage.getItem('jcyouxuan-motion-paused')==='true'}catch{}
function updateMotion(){const paused=motionPaused||reducedMotion.matches;document.documentElement.dataset.motion=paused?'paused':'running';motionButton.disabled=reducedMotion.matches;motionButton.setAttribute('aria-pressed',String(paused));const label=reducedMotion.matches?'静态背景':paused?'播放动效':'暂停动效';motionButton.querySelector('.motion-label')!.textContent=label;motionButton.setAttribute('aria-label',reducedMotion.matches?'已按系统偏好关闭背景动画':paused?'播放背景动画':'暂停背景动画');motionButton.title=motionButton.getAttribute('aria-label')!}
motionButton.addEventListener('click',()=>{motionPaused=!motionPaused;try{sessionStorage.setItem('jcyouxuan-motion-paused',String(motionPaused))}catch{}updateMotion()});reducedMotion.addEventListener('change',updateMotion);updateMotion();
let items:{title:string;url:string;description:string}[]|undefined;let generation=0;
document.querySelector('#site-search')?.addEventListener('input',async e=>{const ticket=++generation;const q=(e.target as HTMLInputElement).value.trim().toLocaleLowerCase();const out=document.querySelector('#search-results')!;const status=document.querySelector('#search-status')!;out.replaceChildren();if(!q){status.textContent='输入关键词搜索站内文章与品牌。';return}try{items??=await fetch('/search.json').then(r=>{if(!r.ok)throw Error();return r.json()});if(ticket!==generation)return;const hits=items!.filter(x=>(x.title+x.description).toLocaleLowerCase().includes(q)).slice(0,20);status.textContent=hits.length?`找到 ${hits.length} 项相关内容`:'没有匹配结果，请尝试更短的词。';for(const hit of hits){const a=document.createElement('a');a.href=hit.url;a.textContent=hit.title;const small=document.createElement('small');small.textContent=hit.description;a.append(small);out.append(a)}}catch{status.textContent='搜索暂不可用，请通过导航浏览。'}});
</script></body></html>
